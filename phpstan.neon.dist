includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    phpVersion:
        min: 80300
        max: 80599
    paths:
        - src
        - config
        - tests/Fixtures
        - benchmarks
    tmpDir: build/phpstan
    # Configuration and cache readers re-check values that PHPDoc describes
    # because PHP does not enforce PHPDoc at runtime and these values come
    # from user configuration or files on disk.
    treatPhpDocTypesAsCertain: false
